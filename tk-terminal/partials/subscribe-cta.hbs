<div class="subscribe-block">
  <div class="subscribe-block__title">stay in the loop</div>
  <p class="subscribe-block__desc">// writing on devrel, developer gtm, building in public, and what nearly two decades in tech actually looks like</p>

  {{#if @member}}
    <p style="font-size: 13px; color: var(--accent);">> you're subscribed. welcome to the loop.</p>
  {{else}}
    <form data-members-form="subscribe" class="subscribe-form">
      <input data-members-email type="email" required placeholder="your@email.com">
      <button type="submit" class="btn btn--primary">[subscribe]</button>
    </form>
  {{/if}}
</div>
