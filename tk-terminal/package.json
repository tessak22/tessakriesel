{
  "name": "tk-terminal",
  "description": "Custom terminal-aesthetic Ghost theme for tessakriesel.com",
  "version": "1.0.0",
  "keywords": ["ghost-theme"],
  "author": {
    "name": "Tessa Kriesel",
    "email": "tessa@tessakriesel.com",
    "url": "https://tessakriesel.com"
  },
  "engines": {
    "ghost": ">=6.0.0",
    "ghost-api": "v6"
  },
  "config": {
    "posts_per_page": 10,
    "image_sizes": {
      "s": { "width": 400 },
      "m": { "width": 750 },
      "l": { "width": 1200 }
    },
    "card_assets": true
  },
  "custom": {
    "github_url": {
      "type": "text",
      "default": "https://github.com/tessak22"
    },
    "twitter_url": {
      "type": "text",
      "default": "https://twitter.com/tessak22"
    },
    "linkedin_url": {
      "type": "text",
      "default": "https://linkedin.com/in/tessak22"
    }
  }
}
