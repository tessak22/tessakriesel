{{!< default}}
{{!-- About page --}}
<div class="container">

  {{!-- Page Header --}}
  <header class="tag-header" style="padding: 3rem 0 2rem;">
    <h1 class="display-lg" style="margin-bottom: 0.5rem;">ABOUT</h1>
    <p style="font-size: 13px; color: var(--text-secondary);">> nearly two decades in tech. still building.</p>
  </header>

  {{!-- Bio Section --}}
  <section class="section">
    <h2 class="section-header">who i am</h2>
    <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem;">
      <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.85; margin-bottom: 1rem;">
        <span style="color: var(--text-dim);">// </span>
        I'm Tessa Kriesel — DevRel leader, founder, builder, and homeschooling mom in Waco, TX. I've spent nearly two decades in tech building developer communities, writing GTM playbooks, and shipping products that developers actually use.
      </p>
      <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.85; margin-bottom: 1rem;">
        <span style="color: var(--text-dim);">// </span>
        I'm currently Founding GTM Lead at Tabstack (Mozilla-backed), founder of Built for Devs (developer advocate matching), and building Selah — a faith-rooted homeschool management platform for my own family and others like us.
      </p>
      <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.85;">
        <span style="color: var(--text-dim);">// </span>
        I write honestly about what it actually takes — the wins, the grind, the building in public, and what it looks like to be a founder, wife, and mom who codes.
      </p>
    </div>
  </section>

  {{!-- Career Timeline as Git Log --}}
  <section class="section">
    <h2 class="section-header">career timeline</h2>
    <div class="git-log" role="list">

      <div class="git-log-entry" role="listitem">
        <div class="git-log-year">2024–</div>
        <div class="git-log-content">
          <div class="git-log-role">Founding GTM Lead @ <span class="git-log-company">Tabstack</span></div>
          <div class="git-log-notes">mozilla-backed · devrel strategy, content, community from zero</div>
        </div>
      </div>

      <div class="git-log-entry" role="listitem">
        <div class="git-log-year">2022–</div>
        <div class="git-log-content">
          <div class="git-log-role">Founder @ <span class="git-log-company">Built for Devs</span></div>
          <div class="git-log-notes">matching elite developer advocates with dev tool companies</div>
        </div>
      </div>

      <div class="git-log-entry" role="listitem">
        <div class="git-log-year">2022–</div>
        <div class="git-log-content">
          <div class="git-log-role">Founder / Builder @ <span class="git-log-company">Selah</span></div>
          <div class="git-log-notes">faith-rooted homeschool management · laravel + livewire</div>
        </div>
      </div>

      <div class="git-log-entry" role="listitem">
        <div class="git-log-year">2020–22</div>
        <div class="git-log-content">
          <div class="git-log-role">Founder @ <span class="git-log-company">Devocate</span></div>
          <div class="git-log-notes">developer advocate network — acquired by Common Room</div>
        </div>
      </div>

      <div class="git-log-entry" role="listitem">
        <div class="git-log-year">2018–20</div>
        <div class="git-log-content">
          <div class="git-log-role">Director of Developer Relations @ <span class="git-log-company">Netlify</span></div>
          <div class="git-log-notes">scaled devrel team · jamstack community · conference strategy</div>
        </div>
      </div>

      <div class="git-log-entry" role="listitem">
        <div class="git-log-year">2016–18</div>
        <div class="git-log-content">
          <div class="git-log-role">Sr. Developer Advocate @ <span class="git-log-company">Pantheon</span></div>
          <div class="git-log-notes">drupal & wordpress ecosystem · agency partnerships</div>
        </div>
      </div>

      <div class="git-log-entry" role="listitem">
        <div class="git-log-year">2006–16</div>
        <div class="git-log-content">
          <div class="git-log-role">Developer → DevRel → Leadership</div>
          <div class="git-log-notes">started writing php at 14 · grew up in the web</div>
        </div>
      </div>

    </div>
  </section>

  {{!-- Skills --}}
  <section class="section">
    <h2 class="section-header">expertise</h2>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem;">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.75rem;">> devrel & community</div>
        <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.7;">Program strategy · content at scale · community building · developer education · conf strategy · hiring & team building</p>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem;">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.75rem;">> developer gtm</div>
        <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.7;">PLG motion · docs-as-marketing · SDK strategy · API developer experience · community-led growth</p>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem;">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.75rem;">> building</div>
        <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.7;">Laravel · PHP · Livewire · Ghost · JavaScript · CLI tools · API integrations · solo founder ops</p>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem;">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.75rem;">> speaking & content</div>
        <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.7;">Keynotes · technical talks · podcast guest · writing · curriculum design · workshop facilitation</p>
      </div>

    </div>
  </section>

  {{!-- Personal --}}
  <section class="section">
    <h2 class="section-header">beyond the work</h2>
    <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem;">
      <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.85; margin-bottom: 0.75rem;">
        <span style="color: var(--text-dim);">// </span>
        Based in Waco, TX with my husband and our homeschooled kids. I live between screens and kitchen tables and long drives with good podcasts.
      </p>
      <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.85;">
        <span style="color: var(--text-dim);">// </span>
        Faith shapes how I work — with integrity, with care, with a long view. I build companies and raise kids with the same operating principle: slow is smooth, smooth is fast.
      </p>
    </div>
  </section>

  {{!-- Social + Wall of Love link --}}
  <section class="section">
    <h2 class="section-header">find me</h2>
    {{> social-links}}
    <p style="margin-top: 1.5rem; font-size: 13px; color: var(--text-secondary);">
      > <a href="/wall-of-love/" style="color: var(--accent);">wall of love</a> — what people say about working with me
    </p>
  </section>

</div>
