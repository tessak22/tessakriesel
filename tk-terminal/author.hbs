{{!-- Author page --}}
<div class="container">

  <header class="author-header">
    {{#author}}
      {{#if profile_image}}
        <img class="author-avatar" src="{{profile_image}}" alt="{{name}}" width="80" height="80">
      {{else}}
        <div style="width:80px;height:80px;background:var(--bg-elevated);border:2px solid var(--border-accent);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:42px;color:var(--accent);flex-shrink:0;">T</div>
      {{/if}}
      <div>
        <h1 class="author-name">{{name}}</h1>
        {{#if bio}}
          <p class="author-bio">{{bio}}</p>
        {{/if}}
        {{#if website}}
          <p style="margin-top:0.5rem;font-size:12px;">
            <a href="{{website}}" style="color:var(--accent);" target="_blank" rel="noopener">{{website}}</a>
          </p>
        {{/if}}
      </div>
    {{/author}}
  </header>

  <p style="font-size:12px;color:var(--text-secondary);margin-bottom:2rem;">
    > {{pagination.total}} posts
  </p>

  <div class="post-feed">
    {{#foreach posts}}
      {{> post-card}}
    {{/foreach}}
  </div>

  {{#if pagination}}
    <nav class="pagination" aria-label="Author pagination">
      {{#if pagination.prev}}
        <a href="{{pagination.prev.url}}" class="prev">newer</a>
      {{else}}
        <span></span>
      {{/if}}
      <span class="text-dim">{{pagination.page}} / {{pagination.pages}}</span>
      {{#if pagination.next}}
        <a href="{{pagination.next.url}}" class="next">older</a>
      {{else}}
        <span></span>
      {{/if}}
    </nav>
  {{/if}}

</div>
