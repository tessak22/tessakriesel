<!DOCTYPE html>
<html lang="{{@site.locale}}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=VT323&family=JetBrains+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
  <link rel="stylesheet" href="{{asset "css/terminal.css"}}">
  <link rel="stylesheet" href="{{asset "css/post.css"}}">

  {{ghost_head}}

  <!-- ASCII T Easter egg — view source to find it -->
  <!--
   ████████
      ██
      ██
      ██
      ██
   // tessakriesel.com — devrel · builder · founder
  -->
</head>
<body class="{{body_class}}">

  <div class="site-wrapper">
    {{> header}}

    <main class="site-main" id="site-main">
      {{{body}}}
    </main>

    {{> footer}}
  </div>

  <script src="{{asset "js/main.js"}}"></script>
  {{#is "post, page"}}
    <script src="{{asset "js/changelog.js"}}"></script>
  {{/is}}

  {{ghost_foot}}
</body>
</html>
